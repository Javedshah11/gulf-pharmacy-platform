{
  "name": "@gulf/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @gulf/media... build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@gulf/media": "workspace:*",
    "@gulf/database": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
