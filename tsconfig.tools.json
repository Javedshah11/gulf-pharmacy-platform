{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "paths": { "@/*": ["./apps/web/*"] }
  },
  "include": ["playwright.config.ts", "tests/browser/**/*.ts"]
}
