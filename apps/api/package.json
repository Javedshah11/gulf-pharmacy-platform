{
  "name": "@gulf/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @gulf/shared build && pnpm --filter @gulf/database build && pnpm --filter @gulf/media build",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @gulf/shared build && pnpm --filter @gulf/database build && pnpm --filter @gulf/media build",
    "test": "pnpm build && node --test --test-concurrency=1 test/*.test.cjs",
    "bootstrap": "pnpm --filter @gulf/shared build && pnpm --filter @gulf/database build && pnpm --filter @gulf/media build && pnpm build && node dist/cli/bootstrap.js"
  },
  "dependencies": {
    "@gulf/database": "workspace:*",
    "@gulf/media": "workspace:*",
    "@gulf/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "argon2": "0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsc-watch": "^7.2.0"
  }
}
